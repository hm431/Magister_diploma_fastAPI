# ============================================================
#  Переменные окружения и секреты — КРИТИЧНО!
#  .env содержит SECRET_KEY, пароль от БД, токены 1С —
#  это никогда не должно попадать в git.
# ============================================================
.env
.env.*
!.env.example                    # пример с пустыми значениями — можно коммитить
!.env.template

# Прочие файлы с секретами
*.pem
*.key
*.crt
secrets/
credentials/

